additional_rows = []

for category, transactions in additional_data.items():
    for transaction in transactions:
        additional_rows.append({
            "Transaction_Text": transaction,
            "Label": category
        })

additional_df = pd.DataFrame(additional_rows)

print(additional_df.shape)
print(additional_df["Label"].value_counts())


# Combine original NLP dataset with our additional examples
final_nlp_df = pd.concat(
    [train_df[["Transaction_Text", "Label"]], additional_df],
    ignore_index=True
)

